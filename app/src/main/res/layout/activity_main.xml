<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.75"
            android:text="@string/app_subtitle"
            android:textSize="13sp" />

        <!-- Quick Test Triggers -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTriggerCts"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/test_cts" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTriggerHonorTranslate"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/test_honor_translate" />
        </LinearLayout>

        <!-- Required Setup -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/section_setup"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOverlayPermission"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/grant_overlay" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAssistantSettings"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/set_google_assistant" />
        </LinearLayout>

        <!-- SECTION 1: Bottom Horizontal Navigation Bar Pill (Easy Tap Style) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/section_nav_bar"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchNavBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/enable_nav_bar" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/nav_tap1_action" />

        <Spinner
            android:id="@+id/spinnerNavTap1"
            android:layout_width="match_parent"
            android:layout_height="44dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/nav_hold_action" />

        <Spinner
            android:id="@+id/spinnerNavHold"
            android:layout_width="match_parent"
            android:layout_height="44dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/nav_tap2_action" />

        <Spinner
            android:id="@+id/spinnerNavTap2"
            android:layout_width="match_parent"
            android:layout_height="44dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/nav_skin" />

        <Spinner
            android:id="@+id/spinnerNavSkin"
            android:layout_width="match_parent"
            android:layout_height="44dp" />

        <TextView
            android:id="@+id/tvNavWidthLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/nav_width_fmt" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderNavWidth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="10"
            android:valueFrom="40"
            android:valueTo="320" />

        <TextView
            android:id="@+id/tvNavThicknessLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_thickness_fmt" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderNavThickness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="2"
            android:valueFrom="4"
            android:valueTo="36" />

        <TextView
            android:id="@+id/tvNavHeightLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_height_fmt" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderNavHeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="4"
            android:valueFrom="0"
            android:valueTo="120" />

        <TextView
            android:id="@+id/tvNavOffsetXLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_offset_x_fmt" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderNavOffsetX"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="10"
            android:valueFrom="-150"
            android:valueTo="150" />

        <TextView
            android:id="@+id/tvNavHoldDelayLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_hold_delay_fmt" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderNavHoldDelay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="50"
            android:valueFrom="150"
            android:valueTo="1000" />

        <TextView
            android:id="@+id/tvNavAlphaLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_alpha_fmt" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderNavAlpha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="5"
            android:valueFrom="0"
            android:valueTo="100" />

        <!-- SECTION 2: Vertical Edge Screen Swipe -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/section_edge_swipe"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchEdgeSwipe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/enable_edge_swipe" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/edge_side" />

        <Spinner
            android:id="@+id/spinnerEdgeSide"
            android:layout_width="match_parent"
            android:layout_height="44dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/swipe_in_action" />

        <Spinner
            android:id="@+id/spinnerSwipeIn"
            android:layout_width="match_parent"
            android:layout_height="44dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/swipe_up_action" />

        <Spinner
            android:id="@+id/spinnerSwipeUp"
            android:layout_width="match_parent"
            android:layout_height="44dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/swipe_down_action" />

        <Spinner
            android:id="@+id/spinnerSwipeDown"
            android:layout_width="match_parent"
            android:layout_height="44dp" />

        <TextView
            android:id="@+id/tvYPosLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/edge_y_pos_fmt" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderYPos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="5"
            android:valueFrom="10"
            android:valueTo="150" />

        <TextView
            android:id="@+id/tvHeightLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/edge_height_fmt" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderHeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="10"
            android:valueFrom="60"
            android:valueTo="260" />

        <TextView
            android:id="@+id/tvAlphaLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/edge_opacity_fmt" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderAlpha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="5"
            android:valueFrom="0"
            android:valueTo="100" />

        <!-- SECTION 3: Custom Time Delays -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/section_timing"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTriggerDelayLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/trigger_delay_fmt" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderTriggerDelay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="50"
            android:valueFrom="0"
            android:valueTo="1500" />

        <TextView
            android:id="@+id/tvHoldDelayLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hold_delay_fmt" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderHoldDelay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="50"
            android:valueFrom="0"
            android:valueTo="1000" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchVibrate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/vibrate_on_trigger" />

        <!-- SECTION 4: Honor MagicOS Screen Translation Target -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/section_honor_translate"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.75"
            android:text="@string/honor_translate_hint"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScanHonorActivities"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/scan_honor_activities" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/component_type" />

        <Spinner
            android:id="@+id/spinnerCompType"
            android:layout_width="match_parent"
            android:layout_height="44dp" />

        <EditText
            android:id="@+id/editHonorPkg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/hint_honor_pkg"
            android:inputType="textNoSuggestions"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/editHonorAct"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/hint_honor_act"
            android:inputType="textNoSuggestions"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApplySettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="28dp"
            android:text="@string/save_apply" />

    </LinearLayout>
</ScrollView>
