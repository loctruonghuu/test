<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Standard permissions only: NO Accessibility Service, NO Developer Options/ADB, NO Root -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".MiCtsPlusApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MiCtsPlus">

        <!-- Main Configuration & Control UI -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Transparent Activity to directly trigger Circle to Search (like MiCTS) -->
        <activity
            android:name=".ui.TriggerCtsActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:finishOnTaskLaunch="true"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.MiCtsPlus.Transparent" />

        <!-- Transparent Activity to request MediaProjection & start Live Translate -->
        <activity
            android:name=".ui.TranslateConsentActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:finishOnTaskLaunch="true"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.MiCtsPlus.Transparent" />

        <!-- Edge Screen Swipe Overlay Service (No Accessibility Service needed) -->
        <service
            android:name=".edge.EdgeSwipeService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Edge swipe gesture handle to trigger Circle to Search and Live Screen Translate without Accessibility Services" />
        </service>

        <!-- Live Screen Translate Service (MediaProjection + ML Kit OCR + Translate) -->
        <service
            android:name=".translate.LiveTranslateService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Quick Settings Tile: Circle to Search -->
        <service
            android:name=".tiles.CtsTileService"
            android:exported="true"
            android:icon="@drawable/ic_cts"
            android:label="@string/tile_cts"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Quick Settings Tile: Live Translate -->
        <service
            android:name=".tiles.TranslateTileService"
            android:exported="true"
            android:icon="@drawable/ic_translate"
            android:label="@string/tile_translate"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Auto-restart Edge Swipe handle after reboot if enabled -->
        <receiver
            android:name=".edge.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
